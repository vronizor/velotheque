# Copy to .env and fill in. Never commit .env.

# Postgres (used by compose for the db container and by the app)
POSTGRES_USER=velotheque
POSTGRES_PASSWORD=change-me
POSTGRES_DB=velotheque
VELOTHEQUE_RO_PASSWORD=change-me-too
# For running the app or tests on the host; compose sets its own for the app container
DATABASE_URL=postgresql+psycopg://velotheque:change-me@localhost:5432/velotheque

# Host paths (USB SSD on the Pi) and the Tailscale IP the db port is published on
VELOTHEQUE_DATA_DIR=/mnt/ssd/velotheque
TAILSCALE_IP=100.x.y.z

# Host port the app listens on (127.0.0.1 only); change it if 8000 is taken
APP_PORT=8000

# Public URL of the app (through Caddy). Its host must equal the Strava "Authorization Callback Domain".
BASE_URL=https://mypi.my-tailnet.ts.net
# Optional: override only for the OAuth redirect, e.g. http://localhost:8000 with an SSH tunnel
# OAUTH_BASE_URL=http://localhost:8000

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# STRAVA_API_BASE=https://www.strava.com/api/v3

# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
