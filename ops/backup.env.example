# /etc/velotheque/backup.env — read by the backup service, ops/restore.sh and install-backup.sh

# Repo checkout holding compose.yaml and .env (the root-run steps use docker compose there)
VELOTHEQUE_DIR=/home/you/velotheque
# Same value as in the repo's .env: photos are read from $VELOTHEQUE_DATA_DIR/photos
VELOTHEQUE_DATA_DIR=/mnt/ssd/velotheque

# Dedicated backup user; its home is the state dir (dumps, photo manifest, Proton session)
BACKUP_USER=velobackup
STATE_DIR=/var/lib/velotheque-backup

# proton-drive CLI: pre-1.0, so the version is pinned and the backup refuses to run with
# any other version. After checking a new release by hand, update the pin.
PROTON_DRIVE_BIN=/usr/local/bin/proton-drive
PROTON_DRIVE_VERSION=0.9.0
# Headless session storage: "pass" (GPG-encrypted, needs `pass` + a GPG key, see README)
# or "unsafe_file" (plain JSON, chmod 600, Proton calls it testing-only)
PROTON_DRIVE_CREDENTIALS_STORE=pass
PROTON_DRIVE_LOG_LEVEL=WARNING

# Remote layout: $REMOTE_PARENT/$REMOTE_FOLDER/{db,photos}
REMOTE_PARENT=/my-files
REMOTE_FOLDER=Velotheque

KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_LOCAL_DUMPS=2
